# Development-only defaults are shown; use secrets in production.
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
API_KEY=change-me-admin
WS_TOKEN=change-me-read-only
TENANT_API_KEYS=tenant-key:acme
CORS_ALLOWED_ORIGINS=http://localhost
WS_ALLOWED_ORIGINS=http://localhost
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me

# WebSocket: tickets efimeros por tenant (POST /api/ws-ticket). WS_AUTH_MODE=ticket es obligatorio en produccion.
# WS_TICKET_SECRET=generate-at-least-32-random-characters
# WS_AUTH_MODE=ticket
# WS_TICKET_TTL=30s
# FRONTEND_WS_TICKET_URL=/api/ws-ticket
# Backend: use NAME_FILE for mounted secrets instead of NAME (never both).
# API_KEY_FILE=/run/secrets/api_key
# WS_TOKEN_FILE=/run/secrets/ws_token
# WS_TICKET_SECRET_FILE=/run/secrets/ws_ticket_secret
# POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password
# NATS_URL_FILE=/run/secrets/nats_url
# REDIS_URL_FILE=/run/secrets/redis_url
# S3_ACCESS_KEY_FILE=/run/secrets/s3_access_key
# S3_SECRET_KEY_FILE=/run/secrets/s3_secret_key

# TLS and tracing (see README for production requirements).
# TLS_CERT_FILE=/run/tls/tls.crt
# TLS_KEY_FILE=/run/tls/tls.key
# TRUSTED_PROXY_CIDRS=10.42.0.0/16
# POSTGRES_SSLROOTCERT=/run/ca/postgres.pem
# NATS_TLS_CA_FILE=/run/ca/nats.pem
# NATS_CREDS_FILE=/run/secrets/nats.creds
# REDIS_TLS_CA_FILE=/run/ca/redis.pem
# S3_TLS_CA_FILE=/run/ca/s3.pem
# OTEL_TRACING_ENABLED=true
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# OTEL_EXPORTER_OTLP_ENDPOINT=https://collector.example.com:4317
# OTEL_EXPORTER_OTLP_HEADERS_FILE=/run/secrets/otlp_headers

# Frontend build-time URLs (public, embedded in the bundle). Override for remote deployments.
# FRONTEND_API_URL=https://analytics.example.com
# FRONTEND_WS_URL=wss://analytics.example.com/ws
# JetStream: use 3 replicas only on a 3-node NATS cluster.
# NATS_STREAM_REPLICAS=1
# NATS_STREAM_MAX_AGE=72h
